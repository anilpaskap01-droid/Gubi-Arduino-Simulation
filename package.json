{
  "name": "gubi-arduino-simulation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-compiler.mjs && tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:browser": "node scripts/browser-check.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "artwork:generate": "node --experimental-strip-types scripts/generate-component-artwork.mjs",
    "test:models": "node scripts/model-check.mjs"
  },
  "dependencies": {
    "@horang-corp/avr-gcc-wasm": "latest",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.0.0",
    "avr8js": "0.21.1",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
